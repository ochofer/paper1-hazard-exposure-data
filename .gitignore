# The price panel is licensed by Financial Modeling Prep and cannot be redistributed,
# so it stays out of git. The manifest is the audit record and IS published: it holds
# checksums and coverage, never prices. See build_manifest.py.
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.json

# Resolved ticker list. Generated by notebook section 4, committed once it is real.
# Kept out until then so a dry run cannot leave a plausible-looking fake in the repo.
config/tickers_v1.csv

# Secrets. Never commit an API key.
.env
*.key

__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store

# Generated by notebook section 2b/2d. Regenerated on every run.
config/tickers_primary.csv
