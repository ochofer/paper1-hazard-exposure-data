# Raw data is reproducible from the notebook; the manifest is the audit record.
data/raw/*
!data/raw/.gitkeep
!data/raw/manifest.json

# Resolved ticker list. Generated by notebook section 4, committed once it is real.
# Kept out until then so a dry run cannot leave a plausible-looking fake in the repo.
config/tickers_v1.csv

# Secrets. Never commit an API key.
.env
*.key

__pycache__/
*.pyc
.ipynb_checkpoints/
.DS_Store
